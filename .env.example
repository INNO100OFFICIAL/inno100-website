# Copy to .env.local for local development. .env.local is gitignored — never
# commit real keys. The same three values go in the Vercel project settings
# (Settings -> Environment Variables) for production.
#
# With none of these set, /api/lead still works: it skips the email step and
# forwards to Formspree, and the confirmation page drops its "check your inbox"
# wording rather than promising mail that was never sent.

# Mailchimp Transactional (formerly Mandrill) API key.
# Mailchimp -> your account menu -> Transactional -> Settings -> API keys.
# Requires a Standard or Premium marketing plan plus a purchased send block.
MAILCHIMP_TRANSACTIONAL_API_KEY=

# The From address on both the team notification and the visitor autoresponse.
# Its domain must be verified and DKIM/SPF-signed in Mailchimp Transactional,
# otherwise sends are rejected per-recipient while still returning HTTP 200.
# Accepts a bare address or `Name <addr@example.com>`.
LEAD_FROM_EMAIL="INNO100 <hello@mail.inno100.ai>"

# Where team notifications land. Optional — defaults to inno1002026@outlook.com.
# Set this to move the notifications without a deploy, e.g. if that mailbox
# starts rejecting mail or the team wants leads somewhere else.
LEAD_TEAM_EMAIL=
