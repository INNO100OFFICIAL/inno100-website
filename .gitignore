# Testing
coverage/

# Next.js
.next/
out/

# Production
build/

# Misc
.DS_Store
*.pem

# Environment files. Matched by prefix rather than enumerated, so a copy or
# backup (.env.local.bak, .env.old) is ignored too — the enumerated list missed
# those, and a stray `git add .` would have committed the keys inside them.
.env*
!.env.example

